# EduVerify Backend Environment Variables
PORT=5001
NODE_ENV=production

# CORS: Set your deployed frontend origin(s), comma-separated (e.g. https://your-frontend.vercel.app)
CORS_ORIGIN=http://localhost:3000

# Cloud PostgreSQL Connection URL (e.g. from Render PostgreSQL, Neon, Supabase, or Railway)
# When DATABASE_URL is set, it takes precedence over individual DB_* variables.
DATABASE_URL=postgresql://user:password@host:5432/eduverify?sslmode=require

# Individual PostgreSQL Connection Credentials (alternative if DATABASE_URL is not used)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eduverify
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_SSL=false

# Optional: Document upload storage directory (defaults to backend/uploads/documents)
# UPLOAD_DIR=/var/data/uploads
